---
const pageTitle = "About Me";
const identity = {
  firstName: "Sarah",
  country: "Canada",
  occupation: "Technical Writer",
  hobbies: ["photography", "birdwatching", "baseball"],
};

const skills = ["HTML", "CSS", "JavaScript", "React", "Astro", "Writing Docs"];
const finished = false;
const goal = 3;
const skinColor = "crimson";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <h1>{pageTitle}</h1>
    <h2>... and my new Astro site!</h2>

    <p>
      I am working through Astro's introductory tutorial. This is the second
      page on my website, and it's the first one I built myself!
    </p>

    <p>
      This site will update as I complete more of the tutorial, so keep checking
      back and see how my journey is going!
    </p>
  </body>
  <p>Here are a few facts about me:</p>
  <ul>
    <li>My name is {identity.firstName}.</li>
    <li>I live in {identity.country} and I work as a {identity.occupation}.</li>
    {
      identity.hobbies.length >= 2 && (
        <li>
          Two of my hobbies are: {identity.hobbies[0]} and {identity.hobbies[1]}
        </li>
      )
    }
  </ul>
  <p>My skills are:</p>
  <ul>
    {skills.map((skill) => <li class="skill">{skill}</li>)}
  </ul>

  <button id="happy-btn">happy</button>
  <button id="not_happy-btn">sad</button>
  <script>
    const button = document.querySelector("#happy-btn") as HTMLElement;
    const nobutton = document.querySelector("#not_happy-btn") as HTMLElement;
    const message = document.querySelector("#happy-msg") as HTMLElement;
    let happy = true;

    button?.addEventListener("click", () => {
      happy = !happy;

      message.hidden = !happy;
      nobutton.hidden = !happy;
      button.hidden = happy;
    });
    nobutton?.addEventListener("click", () => {
      happy = !happy;

      message.hidden = !happy;
      nobutton.hidden = !happy;
      button.hidden = happy;
    });
  </script>
  <p id="happy-msg">I am happy to be learning Astro!</p>

  {finished && <p>I finished this tutorial!</p>}

  {
    goal === 3 ? (
      <p>My goal is to finish in 3 days.</p>
    ) : (
      <p>My goal is not 3 days.</p>
    )
  }
</html>
<style define:vars={{ skinColor }}>
  h1 {
    color: purple;
    font-size: 2rem;
  }
  .skill {
    color: var(--skinColor);
  }
</style>
